# ══════════════════════════════════════════════════════════════════════════════
# CV Pipeline — Configuration complète
# Copiez ce fichier en ".env" et remplissez vos valeurs.
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. Clés API LLM ──────────────────────────────────────────────────────────
# Au moins UNE clé est obligatoire pour l'extraction des CVs.
# Obtenez une clé Groq gratuite sur https://console.groq.com

GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
MISTRAL_API_KEY=your_mistral_key_here

# ── 2. Fallback automatique entre providers ───────────────────────────────────
# Si le quota d'un provider est atteint, le suivant est utilisé automatiquement.
AUTO_FALLBACK=true
FALLBACK_ORDER=groq,openrouter,mistral,gemini

# ── 3. Elasticsearch ─────────────────────────────────────────────────────────
ELASTIC_HOST=http://localhost:9200
# ELASTIC_USERNAME=elastic
# ELASTIC_PASSWORD=changeme

# ── 4. Score qualité — pondération (total = 100) ─────────────────────────────
# Ces 5 valeurs doivent additionner à 100.
# Elles pondèrent le score final de qualité de chaque CV.
#
#   score_final = diplome*A + certifications*B + tech*C + projets*D + langues*E
#                 ──────────────────────────────────────────────────────────────
#                                   100
#
# A — Poids du diplôme (niveau académique)
QUALITY_WEIGHT_DIPLOME=25

# B — Poids des certifications (AWS, Azure, PMP, etc.)
QUALITY_WEIGHT_CERTIFICATIONS=20

# C — Poids de la diversité technique (nombre de techno différentes)
QUALITY_WEIGHT_TECH=20

# D — Poids des projets (nombre et complexité)
QUALITY_WEIGHT_PROJETS=25

# E — Poids des langues (nombre de langues maîtrisées)
QUALITY_WEIGHT_LANGUES=10

# ── 5. Détection de doublons — seuils de similarité ─────────────────────────
# Niveau 3 : similarité cosinus entre embeddings multilingues.
#
# DEDUP_SIMILARITY_THRESHOLD : seuil à partir duquel 2 CVs sont considérés
#   comme le MÊME candidat → CV rejeté comme doublon.
#   Valeur par défaut : 0.90  (90% de similarité)
#   → Augmenter (ex: 0.95) pour être plus permissif (moins de faux doublons)
#   → Diminuer (ex: 0.85) pour être plus strict (plus de doublons détectés)
DEDUP_SIMILARITY_THRESHOLD=0.90

# DEDUP_UPDATE_THRESHOLD : seuil à partir duquel un CV est considéré comme
#   une MISE À JOUR du même candidat (ex: nouveau poste sur même CV).
#   Valeur par défaut : 0.98  (98% de similarité)
#   → Doit toujours être supérieur à DEDUP_SIMILARITY_THRESHOLD
DEDUP_UPDATE_THRESHOLD=0.98
